{
  "openapi": "3.1.1",
  "info": {
    "title": "Order.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7278"
    },
    {
      "url": "http://localhost:5131"
    }
